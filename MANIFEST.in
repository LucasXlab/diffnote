include README*.md LICENSE PRIVACY.md SECURITY.md CONTRIBUTING.md GOOD_FIRST_ISSUES.md Makefile .env.example LAUNCH.md
recursive-include docs *.md
recursive-include assets *.svg *.png *.gif *.cast *.txt *.json *.md
recursive-include scripts *.py *.sh
recursive-include tests *
recursive-include .github *.yml *.yaml *.md
global-exclude *.py[cod]
